{
	"name": "headless-svg-to-excalidraw",
	"version": "0.0.21",
	"description": "Convert SVG to Excalidraw's file format, no browser required.",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/awhiteside1/headless-svg-to-excalidraw.git"
	},
	"bugs": {
		"url": "https://github.com/awhiteside1/headless-svg-to-excalidraw/issues"
	},
	"homepage": "https://github.com/awhiteside1/headless-svg-to-excalidraw#readme",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"package.json"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"test": "bun test tests/*.test.ts",
		"lint": "biome check --write",
		"test:visual": "playwright test",
		"test:visual:update": "UPDATE_SNAPSHOTS=1 playwright test"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@excalidraw/excalidraw": "^0.18.1",
		"@playwright/test": "^1.59.1",
		"@tsconfig/bun": "^1.0.10",
		"@types/bun": "^1.3.7",
		"@types/chroma-js": "^2.1.3",
		"odiff-bin": "^4.3.8",
		"playwright-odiff": "^4.4.0-beta.1",
		"tsdown": "^0.20.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
      "@excalidraw/excalidraw": "^0.18.0",
      "typescript": "^4.5.5"
	},
	"dependencies": {
		"chroma-js": "^2.1.2",
		"gl-matrix": "^3.3.0",
		"linkedom": "^0.18.12",
		"nanoid": "5.0.9",
		"path-data-parser": "^0.1.0",
		"points-on-curve": "^0.2.0",
		"points-on-path": "^0.2.1",
		"roughjs": "^4.4.1",
		"shiki": "^4.0.2",
		"svgo": "^4.0.1"
	}
}
